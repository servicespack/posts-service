{
  "name": "@servicespack/posts-service",
  "version": "1.0.0",
  "description": "Posts service for text posts, replies and reactions",
  "main": "dist/index.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "start": "node dist/index.mjs",
    "start:dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.10.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "mongodb-memory-server": "^11.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
