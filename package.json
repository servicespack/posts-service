{
  "name": "@servicespack/posts-service",
  "type": "module",
  "version": "1.0.0",
  "description": "Posts service for text posts, replies and reactions",
  "main": "dist/index.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "start": "node dist/index.mjs",
    "start:dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.10.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.2",
    "@types/pino-http": "^5.8.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.11.0",
    "mongodb-memory-server": "11.3.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
